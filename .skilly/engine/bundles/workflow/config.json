  "rules": ["conventional-commits", "naming"],
  "verify": {
    "steps": [
      {
        "name": "conventional-commits",
        "stage": "push",
        "run": "node .agents/skills/verify/scripts/check-commit-msg.mjs --branch",
        "why": "Every commit the branch adds over its base, checked by the commit-msg hook's own script. A commit made with --no-verify shows up here."
      },
      {
        "name": "naming",
        "stage": "push",
        "run": "node .agents/skills/naming/scripts/check.mjs",
        "target": ".agents/skills/naming/scripts/check.mjs",
        "why": "The naming Rule on the files the branch changes. Fix a finding, or add an allow entry to .skilly/naming.json."
      }
    ]
  },
